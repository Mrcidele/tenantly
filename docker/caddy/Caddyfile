# TLS automático para subdomínios e domínios customizados (on-demand TLS).
# O Caddy só emite certificado se o app responder 200 no "ask".
{
	email {$ACME_EMAIL:ops@tenantly.com}
	on_demand_tls {
		ask http://app:8000/internal/tls/ask
	}
}

https:// {
	tls {
		on_demand
	}

	encode zstd gzip
	reverse_proxy app:8000 {
		header_up X-Forwarded-Proto {scheme}
	}
}
