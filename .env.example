APP_NAME=Tenantly
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://tenantly.localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Tenancy
TENANCY_CENTRAL_DOMAIN=tenantly.localhost
TENANCY_ADMIN_DOMAIN=admin.tenantly.localhost
TENANCY_CNAME_TARGET=cname.tenantly.localhost
TENANCY_RESOLUTION_CACHE_TTL=300

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Postgres: três papéis (ver docker/postgres/roles.sql)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tenantly
DB_USERNAME=tenantly_app
DB_PASSWORD=app
DB_ADMIN_USERNAME=tenantly_admin
DB_ADMIN_PASSWORD=admin
DB_MIGRATOR_USERNAME=tenantly_migrator
DB_MIGRATOR_PASSWORD=migrator

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Cookie restrito ao host: a sessão de acme.tenantly.com não vale em globex.tenantly.com
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@tenantly.localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Cobrança: fake | asaas | stripe
BILLING_GATEWAY=fake
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

OCTANE_SERVER=frankenphp
PULSE_ENABLED=true

VITE_APP_NAME="${APP_NAME}"
